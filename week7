package main
import "fmt"
func main() {
 var str string
 fmt.Print("Enter a string: ")
 fmt.Scan(&str)
 isPalindrome := true
 n := len(str)
 for i := 0; i < n/2; i++ {
 if str[i] != str[n-1-i] {
 isPalindrome = false
 break
 }
 }
 if isPalindrome {
 fmt.Println("The string is a palindrome")
 } else {
 fmt.Println("The string is not a palindrome")}}
